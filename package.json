{
  "name": "@belsar-ai/joplin-mcp",
  "version": "4.1.2",
  "type": "module",
  "description": "Model Context Protocol (MCP) server for Joplin note-taking app",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "joplin-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "start": "node dist/cli.js",
    "dev": "tsc --watch",
    "prepare": "npm run build && (test -d .git && ./scripts/setup-husky.sh || true)",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "lint": "eslint . --fix",
    "lint:fix": "eslint . --fix",
    "lint:ci": "eslint . --max-warnings 0",
    "prepublishOnly": "npm test",
    "release:patch": "npm version patch -m 'Release %s'",
    "release:minor": "npm version minor -m 'Release %s'",
    "release:major": "npm version major -m 'Release %s'",
    "release:beta": "npm version prerelease --preid=beta -m 'Release %s'"
  },
  "keywords": [
    "mcp",
    "joplin",
    "notes",
    "model-context-protocol",
    "ai",
    "llm"
  ],
  "author": "Kyle Lyon",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/belsar-ai/joplin-mcp.git"
  },
  "homepage": "https://github.com/belsar-ai/joplin-mcp#readme",
  "bugs": {
    "url": "https://github.com/belsar-ai/joplin-mcp/issues"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.75",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "smol-toml": "^1.8.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0"
  },
  "lint-staged": {
    "src/**/*.{ts,js}": [
      "prettier --write",
      "eslint --fix --max-warnings 0"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
